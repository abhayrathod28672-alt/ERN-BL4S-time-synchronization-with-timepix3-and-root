    s1_x=500.0,

    # --- delay wire chambers -------------------------------------------------
    #  sensitive area 10 x 10 cm, resolution 200-300 um (BL4S 2026)
    dwc_win=13.0, dwc_w=34.0, dwc_h=34.0, dwc_t=10.0,
    dwc0_x=545.0,
    dwc1_x=592.0,

    # --- scintillator sizes (1x1 cm up to 10x20 cm are available) -----------
    sc_w=14.0, sc_h=14.0, sc_t=3.0,

